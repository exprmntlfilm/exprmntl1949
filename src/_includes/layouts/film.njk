---
layout: layouts/base.njk
---
{% set galleryImages = still | combineGallery(gallery) %}

<main>
  <section class="shell page-head">
    <a class="link-arrow" href="../films.html">&larr; Back to Films</a>
    <p class="eyebrow" style="margin-top:18px;">{{ cat_num | catDisplay }}</p>
    <h1>{{ title }}</h1>
  </section>

  <section class="shell section">
    <div class="two-col">
      <div class="placeholder-frame" style="aspect-ratio:4/3;">
        {% if still %}
        <img src="../{{ still }}" alt="{{ title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
        {% else %}
        <span class="placeholder-mark">Still, to be added</span>
        {% endif %}
      </div>
      <div class="stack">
        {% if edition_label %}<span class="tag">{{ edition_label }}</span>{% else %}<span class="tag">Edition {{ edition }}</span>{% endif %}
        <p class="body-copy" style="margin:0;">
          <strong>Director{% if directors.length > 1 %}s{% endif %}:</strong>
          {{ directors | directorLinks(collections.peopleSorted, "../") | safe }}
        </p>
        {% if content %}<div class="body-copy">{{ content | safe }}</div>{% endif %}
        {% if awards.length %}
        <div class="awards-block">
          <p class="awards-heading">&#127942; Awards</p>
          <ul class="awards-list">
            {% for a in awards %}<li>{{ a }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Resources</p>
        <h2>Prints, stills &amp; documents</h2>
      </div>
    </div>
    <div class="doc-list">
      <div class="doc-row">
        <span class="doc-num">DOC.01</span>
        <div><span class="doc-name">Film stills</span>{% if galleryImages.length > 1 %}<span class="doc-sub">{{ galleryImages.length }} photos</span>{% endif %}</div>
        {% if galleryImages.length > 1 %}
        <button class="doc-status gallery-btn" data-gallery-images='{{ galleryImages | json | safe }}' data-gallery-title="{{ title }}" data-gallery-root="../">View Gallery</button>
        {% else %}
        <span class="doc-status">To be added</span>
        {% endif %}
      </div>
      {% for r in resources %}
      <div class="doc-row">
        <span class="doc-num">{{ loop.index0 | docLabel(2) }}</span>
        <div><span class="doc-name">{{ r.name }}</span></div>
        {% if r.file %}
        <a class="doc-status" href="../{{ r.file }}" target="_blank" rel="noopener">View</a>
        {% elif r.url %}
        <a class="doc-status" href="{{ r.url }}" target="_blank" rel="noopener">View</a>
        {% else %}
        <span class="doc-status">To be added</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
</main>
