---
layout: layouts/base.njk
---
{% set galleryImages = photo | combineGallery(gallery, photo_caption) %}
{% set editionsList = editions %}

<main>
  <section class="shell page-head">
    <a class="link-arrow" href="../people.html">&larr; Back to People</a>
    <p class="eyebrow" style="margin-top:18px;">{{ role or "Filmmaker" }}{% if country %} — {{ country }}{% endif %}</p>
    <h1>{{ name }}</h1>
  </section>

  <section class="shell section">
    <div class="two-col">
      <div>
        <div class="placeholder-frame" style="aspect-ratio:3/4;">
          {% if photo %}
          <img src="../{{ photo }}" alt="{{ name }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
          {% else %}
          <span class="placeholder-mark">Portrait, to be added</span>
          {% endif %}
        </div>
        {% if photo_caption %}<p class="media-caption">{{ photo_caption }}</p>{% endif %}
      </div>
      <div class="stack">
        {% if editions_label %}<span class="tag">{{ editions_label }}</span>{% else %}{% for e in editionsList %}<span class="tag">Edition {{ e }}</span> {% endfor %}{% endif %}
        <h2>{% if role_heading %}{{ role_heading }}{% elif editionsList.length == 1 %}Filmmaker at {{ editionsList[0] | editionLabel }} ({{ editionsList[0] }}){% else %}Filmmaker across multiple editions{% endif %}</h2>
        {% if content %}<div class="body-copy">{{ content | safe }}</div>{% endif %}
        {% if awards.length %}
        <div class="awards-block">
          <p class="awards-heading">&#127942; Awards</p>
          <ul class="awards-list">
            {% for a in awards %}<li>{{ a }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Related</p>
        <h2>Films in the collection</h2>
      </div>
    </div>
    <div class="grid">
      {{ films | filmCards(collections.filmsSorted, "../") | safe }}
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Resources</p>
      </div>
    </div>
    <div class="doc-list">
      <div class="doc-row">
        <span class="doc-num">DOC.01</span>
        <div><span class="doc-name">Photographs</span>{% if galleryImages.length > 1 %}<span class="doc-sub">{{ galleryImages.length }} photos</span>{% endif %}</div>
        {% if galleryImages.length > 1 %}
        <button class="doc-status gallery-btn" data-gallery-images='{{ galleryImages | json | safe }}' data-gallery-title="{{ name }}" data-gallery-root="../">View Gallery</button>
        {% else %}
        <span class="doc-status">To be added</span>
        {% endif %}
      </div>
      {% for r in resources %}
      <div class="doc-row">
        <span class="doc-num">{{ loop.index0 | docLabel(2) }}</span>
        <div><span class="doc-name">{{ r.name }}</span></div>
        {% if r.file %}
        <a class="doc-status" href="../{{ r.file }}" target="_blank" rel="noopener">View</a>
        {% elif r.url %}
        <a class="doc-status" href="{{ r.url }}" target="_blank" rel="noopener">View</a>
        {% else %}
        <span class="doc-status">To be added</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
</main>
