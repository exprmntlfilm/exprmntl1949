---
layout: layouts/base.njk
---
<main>
  <section class="shell page-head">
    <a class="link-arrow" href="../stories.html">&larr; Back to Stories</a>
    <p class="eyebrow" style="margin-top:18px;">Story</p>
    <h1>{{ title }}</h1>
  </section>

  <section class="shell section">
    <div class="two-col">
      <div class="placeholder-frame" style="aspect-ratio:4/3;">
        {% if image %}
        <img src="../{{ image }}" alt="{{ title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
        {% else %}
        <span class="placeholder-mark">Illustration, to be added</span>
        {% endif %}
      </div>
      <div class="stack">
        {% if edition %}<span class="tag">Edition {{ edition }}</span>{% endif %}
        {% if content %}<div class="body-copy">{{ content | safe }}</div>{% endif %}
        {% if source %}<p class="story-attrib" style="margin-top:8px;">{{ source }}</p>{% endif %}
      </div>
    </div>
  </section>
</main>
