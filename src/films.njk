---
layout: layouts/base.njk
root: ""
section: "films"
title: "Films"
eleventyComputed:
  permalink: "films.html"
---
{% set editionsOrder = [1949, 1958, 1963, 1967, 1974] %}
{% set editionLabels = {1949: "EXPRMNTL 1", 1958: "EXPRMNTL 2", 1963: "EXPRMNTL 3", 1967: "EXPRMNTL 4", 1974: "EXPRMNTL 5"} %}

<main>
  <section class="shell page-head">
    <p class="eyebrow">Films</p>
    <h1>The catalogue</h1>
    <p class="body-copy">Every film entered at one of the five editions, drawn from the surviving festival records, one catalogue card per title. Co-directed films are cross-listed on each director's page but appear only once here. Stills and prints are still being digitized.</p>
  </section>

  {% for ed in editionsOrder %}
  {% set filmsInEdition = collections.filmsSorted | byEdition(ed) %}
  <section class="shell section" id="films-{{ ed }}">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ editionLabels[ed] }} &middot; {{ ed }}</p>
        <h2>{{ filmsInEdition.length }} film{% if filmsInEdition.length != 1 %}s{% endif %} in the catalogue</h2>
      </div>
    </div>
    <div class="grid-wrap" data-collapsible>
      <div class="grid">
        {{ filmsInEdition | filmCardsFromList("") | safe }}
      </div>
      <div class="grid-fade"></div>
    </div>
    <button class="grid-toggle" data-toggle-label-more="Show all {{ filmsInEdition.length }} films" data-toggle-label-less="Show fewer films">Show all {{ filmsInEdition.length }} films</button>
  </section>
  {% endfor %}
</main>
